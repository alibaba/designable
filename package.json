{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "formily/antd",
    "formily/setters",
    "formily/transformer",
    "examples/*"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "clean": "lerna clean",
    "build": "rimraf -rf packages/*/{lib,esm} && lerna run build",
    "build:docs": "dumi build",
    "start": "dumi dev",
    "start:playground": "npm run start:basic",
    "start:basic": "yarn workspace @designable/basic-example start",
    "start:sandbox": "yarn workspace @designable/sandbox-example start",
    "start:multi-workspace": "yarn workspace @designable/multi-workspace-example start",
    "start:sandbox-multi-workspace": "yarn workspace @designable/sandbox-multi-workspace-example start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:prod": "jest --coverage --silent",
    "preversion": "npm run build && npm run lint",
    "version": "ts-node scripts/release changelog && git add -A",
    "version:alpha": "lerna version prerelease --preid alpha",
    "version:beta": "lerna version prerelease --preid beta",
    "version:rc": "lerna version prerelease --preid rc",
    "version:patch": "lerna version patch",
    "version:minor": "lerna version minor",
    "version:preminor": "lerna version preminor --preid beta",
    "version:major": "lerna version major",
    "release:github": "ts-node scripts/release release",
    "release:force": "lerna publish from-package --yes",
    "prelease:force": "lerna publish from-package --yes --dist-tag next",
    "release": "lerna publish",
    "prelease": "lerna publish --dist-tag next",
    "lint": "eslint --ext .ts,.tsx,.js  --fix",
    "check:antd5": "ts-node scripts/check-antd5-deprecations.ts"
  },
  "resolutions": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@formily/antd-v5": "^1.2.0",
    "@formily/core": "^2.3.0",
    "@formily/json-schema": "^2.3.0",
    "@formily/path": "^2.3.0",
    "@formily/react": "^2.3.0",
    "@formily/reactive": "^2.3.0",
    "@formily/reactive-react": "^2.3.0",
    "@formily/shared": "^2.3.0",
    "@testing-library/dom": "^10.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/dateformat": "^5.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/hoist-non-react-statics": "^3.3.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "antd": "^5.24.0",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "concurrently": "^9.1.0",
    "conventional-commit-types": "^3.0.0",
    "cool-path": "^1.0.6",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "cz-conventional-changelog": "^3.3.0",
    "escape-string-regexp": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "execa": "^9.5.0",
    "findup": "^0.1.5",
    "fs-extra": "^11.3.0",
    "gh-release": "^7.0.2",
    "glob": "^11.0.0",
    "html-webpack-plugin": "^5.6.3",
    "immutable": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^8.2.0",
    "less": "^4.3.0",
    "less-loader": "^12.3.0",
    "less-plugin-npm-import": "^2.1.0",
    "lint-staged": "^15.5.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.1.0",
    "moment": "^2.30.0",
    "monaco-editor": "^0.52.0",
    "postcss": "^8.5.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.5.0",
    "pretty-format": "^29.7.0",
    "prop-types": "^15.8.1",
    "pretty-quick": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "rimraf": "^6.0.0",
    "rollup": "^4.40.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "semver": "^7.7.0",
    "semver-regex": "^4.0.5",
    "showdown": "^2.1.0",
    "staged-git-files": "^1.3.0",
    "string-similarity": "^4.0.4",
    "style-loader": "^4.0.0",
    "styled-components": "^6.1.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/designable.git"
  },
  "config": {
    "ghooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "node ./scripts/validate-commit-msg.js"
    },
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --ext .ts,.tsx,.js --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.0"
  }
}
