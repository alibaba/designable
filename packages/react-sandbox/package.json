{
  "name": "@designable/react-sandbox",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/designable.git"
  },
  "bugs": {
    "url": "https://github.com/alibaba/designable/issues"
  },
  "homepage": "https://github.com/alibaba/designable#readme",
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && ../../node_modules/.bin/tsc -p tsconfig.json && node scripts/add-js-extensions.js",
    "prepare": "yarn build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@designable/react": "workspace:*",
    "@designable/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
