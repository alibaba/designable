    "@formily/core": "^2.0.2",
    "@formily/react": "^2.0.2",
    "@formily/reactive": "^2.0.2",
    "@formily/shared": "^2.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
